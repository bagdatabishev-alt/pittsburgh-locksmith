'use client';

import { useState, useEffect } from 'react';
import { createClient } from '@supabase/supabase-js';

// Supabase қосылымы (өзіңіздің кілттеріңіз немесе бар импортты қолдана аласыз)
const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
const supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseAnonKey);

export default function AdminDashboard() {
  const [requests, setRequests] = useState([]);
  const [techs, setTechs] = useState([]);
  const [loading, setLoading] = useState(true);

  // Деректерді базадан алу
  const fetchData = async () => {
    setLoading(true);
    try {
      // Requests кестесін алу
      const { data: reqData, error: reqError } = await supabase
        .from('requests')
        .select('*')
        .order('created_at', { ascending: false });

      if (reqError) throw reqError;
      setRequests(reqData || []);

      // Techs (мастерлер) тізімін алу
      const { data: techData, error: techError } = await supabase
        .from('techs')
        .select('*');

      if (techError) throw techError;
      setTechs(techData || []);
    } catch (error) {
      console.error('Қате шықты:', error.message);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  // Мастер тағайындау функциясы
  const handleAssignTech = async (requestId, techId) => {
    try {
      const { error } = await supabase
        .from('requests')
        .update({ tech_id: techId })
        .eq('id', requestId);

      if (error) throw error;
      alert('Мастер сәтті тағайындалды!');
      fetchData();
    } catch (error) {
      console.error('Қате:', error.message);
      alert('Мастерді тағайындау кезінде қате шықты');
    }
  };

  // Тапсырысты жою функциясы
  const handleDelete = async (requestId) => {
    if (!confirm('Бұл тапсырысты шынымен жойғыңыз келеді ме?')) return;
    try {
      const { error } = await supabase
        .from('requests')
        .delete()
        .eq('id', requestId);

      if (error) throw error;
      fetchData();
    } catch (error) {
      console.error('Қате:', error.message);
    }
  };

  return (
    <main style={{ padding: '20px', fontFamily: 'sans-serif', background: '#121212', color: '#fff', minHeight: '100vh' }}>
      <h1>Админ панелі - Басқару</h1>
      
      <div style={{ margin: '20px 0' }}>
        <button 
          onClick={fetchData} 
          style={{ padding: '10px 20px', background: '#0070f3', color: '#fff', border: 'none', borderRadius: '5px', cursor: 'pointer' }}
        >
          Жаңарту (Refresh)
        </button>
      </div>

      <h2>Шұғыл өтініштер (Requests)</h2>

      {loading ? (
        <p>Жүктелуде...</p>
      ) : (
        <div style={{ overflowX: 'auto' }}>
          <table style={{ width: '100%', borderCollapse: 'collapse', marginTop: '10px', background: '#1e1e1e' }}>
            <thead>
              <tr style={{ background: '#252525', textAlign: 'left', borderBottom: '1px solid #333' }}>
                <th style={{ padding: '12px' }}>АТЫ</th>
                <th style={{ padding: '12px' }}>ТЕЛЕФОН</th>
                <th style={{ padding: '12px' }}>ҚЫЗМЕТ</th>
                <th style={{ padding: '12px' }}>МЕКЕНЖАЙ / ЕСКЕРТУ</th>
                <th style={{ padding: '12px' }}>УАҚЫТЫ</th>
                <th style={{ padding: '12px' }}>СТАТУС (Мастер жауабы)</th>
                <th style={{ padding: '12px' }}>ӘРЕКЕТ / МАСТЕР</th>
              </tr>
            </thead>
            <tbody>
              {requests.length === 0 ? (
                <tr>
                  <td colSpan="7" style={{ padding: '20px', textAlign: 'center' }}>Әзірге өтініштер жоқ</td>
                </tr>
              ) : (
                requests.map((req) => (
                  <tr key={req.id} style={{ borderBottom: '1px solid #333' }}>
                    <td style={{ padding: '12px' }}>{req.name}</td>
                    <td style={{ padding: '12px' }}>{req.phone}</td>
                    <td style={{ padding: '12px' }}>{req.service}</td>
                    <td style={{ padding: '12px' }}>{req.address} {req.note ? `(${req.note})` : ''}</td>
                    <td style={{ padding: '12px' }}>{new Date(req.created_at).toLocaleString()}</td>
                    
                    {/* ЖАҢА ҚОСЫЛҒАН БӨЛІМ: Статусты көрсету */}
                    <td style={{ padding: '12px', fontWeight: 'bold' }}>
                      {req.status === 'completed' && (
                        <span style={{ color: '#4ade80' }}>Орындалды ✅</span>
                      )}
                      {req.status === 'returned' && (
                        <span style={{ color: '#f87171' }}>Істей алмады ❌</span>
                      )}
                      {(!req.status || req.status === 'pending') && (
                        <span style={{ color: '#fbbf24' }}>Күтуде / Орындалуда ⏳</span>
                      )}
                    </td>

                    <td style={{ padding: '12px', display: 'flex', gap: '10px', alignItems: 'center' }}>
                      <select 
                        defaultValue={req.tech_id || ""}
                        onChange={(e) => handleAssignTech(req.id, e.target.value)}
                        style={{ padding: '6px', background: '#333', color: '#fff', border: 'none', borderRadius: '4px' }}
                      >
                        <option value="" disabled>Мастерді таңдаңыз</option>
                        {techs.map((tech) => (
                          <option key={tech.id} value={tech.id}>
                            {tech.name || `Мастер #${tech.id}`}
                          </option>
                        ))}
                      </select>

                      <button 
                        onClick={() => handleDelete(req.id)}
                        style={{ padding: '6px 12px', background: '#dc2626', color: '#fff', border: 'none', borderRadius: '4px', cursor: 'pointer' }}
                      >
                        Жою
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      )}
    </main>
  );
}